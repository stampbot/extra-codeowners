  "statements": [
    {
      "impact_statement": "The affected PCRE2 JIT API requires attacker-controlled regular expressions and JIT stack use. The shipped service matches policy with Python re, does not call PCRE2 JIT APIs, and does not load the named Debian libpcre2 library. The ARM64 psycopg wheel has a separate private PCRE2 copy whose private SELinux caller does not import JIT APIs; this statement does not exempt that wheel library, custom FFI, native plugins, or arbitrary programs run inside the container.",
      "products": [
        {
          "@id": "pkg:deb/debian/libpcre2-8-0@10.46-1~deb13u2?arch=amd64&distro=debian-13.7&upstream=pcre2",
          "identifiers": {
            "purl": "pkg:deb/debian/libpcre2-8-0@10.46-1~deb13u2?arch=amd64&distro=debian-13.7&upstream=pcre2"
          }
        },
        {
          "@id": "pkg:deb/debian/libpcre2-8-0@10.46-1~deb13u2?arch=arm64&distro=debian-13.7&upstream=pcre2",
          "identifiers": {
            "purl": "pkg:deb/debian/libpcre2-8-0@10.46-1~deb13u2?arch=arm64&distro=debian-13.7&upstream=pcre2"
          }
        }
      ],
      "status": "not_affected",
      "status_notes": "Analysis detail: The affected PCRE2 JIT API requires attacker-controlled regular expressions and JIT stack use. The shipped service matches policy with Python re, does not call PCRE2 JIT APIs, and does not load the named Debian libpcre2 library. The ARM64 psycopg wheel has a separate private PCRE2 copy whose private SELinux caller does not import JIT APIs; this statement does not exempt that wheel library, custom FFI, native plugins, or arbitrary programs run inside the container.\nSource: PCRE2 maintainer advisory (https://github.com/PCRE2Project/pcre2/security/advisories/GHSA-r9hj-j2rw-4q3m)\nOriginal Vexcalibur analysis state: not_affected",
      "vulnerability": {
        "name": "CVE-2026-103111"
      }
    },
