  "statements": [
    {
      "impact_statement": "The shipped Extra CODEOWNERS service uses Python zlib.compress and decompressobj for bounded in-memory discovery-cache bodies, not the C gz* file-writer interface. CPython's zlib extensions on amd64 and arm64 import deflate/inflate and checksum APIs, with no gz* imports. A scan of all 778 ELF files in each published image found gz* imports only in dpkg-deb and libapt-pkg; application entrypoints, HTTP routes, healthchecks and migrations neither invoke those programs nor load the APT library. The vulnerable gzip-writer path is outside the reviewed service execution path. The Debian zlib1g package remains present and unpatched. This does not cover operator-run package management, custom FFI or plugins, arbitrary commands, or execution after compromise.",
      "justification": "vulnerable_code_not_in_execute_path",
      "products": [
        {
          "@id": "pkg:deb/debian/zlib1g@1:1.3.dfsg%2Breally1.3.1-1%2Bb1?arch=amd64&distro=debian-13.7",
          "identifiers": {
            "purl": "pkg:deb/debian/zlib1g@1:1.3.dfsg%2Breally1.3.1-1%2Bb1?arch=amd64&distro=debian-13.7"
          }
        },
        {
          "@id": "pkg:deb/debian/zlib1g@1:1.3.dfsg%2Breally1.3.1-1%2Bb1?arch=arm64&distro=debian-13.7",
          "identifiers": {
            "purl": "pkg:deb/debian/zlib1g@1:1.3.dfsg%2Breally1.3.1-1%2Bb1?arch=arm64&distro=debian-13.7"
          }
        }
      ],
      "status": "not_affected",
      "status_notes": "Analysis detail: The shipped Extra CODEOWNERS service uses Python zlib.compress and decompressobj for bounded in-memory discovery-cache bodies, not the C gz* file-writer interface. CPython's zlib extensions on amd64 and arm64 import deflate/inflate and checksum APIs, with no gz* imports. A scan of all 778 ELF files in each published image found gz* imports only in dpkg-deb and libapt-pkg; application entrypoints, HTTP routes, healthchecks and migrations neither invoke those programs nor load the APT library. The vulnerable gzip-writer path is outside the reviewed service execution path. The Debian zlib1g package remains present and unpatched. This does not cover operator-run package management, custom FFI or plugins, arbitrary commands, or execution after compromise.\nSource: Extra CODEOWNERS native caller review (https://security-tracker.debian.org/tracker/CVE-2026-76844)\nOriginal Vexcalibur analysis state: not_affected",
      "timestamp": "2026-11-10T06:52:41Z",
